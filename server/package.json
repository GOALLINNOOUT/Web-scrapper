{
  "name": "@crawler/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "axios": "^1.7.9",
    "bullmq": "^5.77.6",
    "cheerio": "1.0.0",
    "cors": "^2.8.5",
    "css-select": "^5.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.11.0",
    "mongoose": "^8.9.5",
    "playwright": "^1.52.0",
    "whois": "^2.16.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
