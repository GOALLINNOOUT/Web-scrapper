FROM mcr.microsoft.com/playwright:v1.60.0-noble AS build
WORKDIR /app
COPY package*.json ./
COPY server/package*.json server/
COPY client/package*.json client/
RUN --mount=type=cache,target=/root/.npm npm ci --fetch-retries=5 --fetch-retry-factor=2 --fetch-timeout=120000
COPY . .
RUN npm run build --workspace server

FROM mcr.microsoft.com/playwright:v1.60.0-noble
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
COPY server/package*.json server/
COPY client/package*.json client/
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --workspace server --fetch-retries=5 --fetch-retry-factor=2 --fetch-timeout=120000
COPY --from=build /app/server/dist server/dist
CMD ["npm", "run", "start", "--workspace", "server"]
