FROM golang:1.22-bookworm AS go-build
WORKDIR /app/services/crawler-go
COPY services/crawler-go/go.mod ./
COPY services/crawler-go/main.go ./
RUN go mod download \
  && go run github.com/playwright-community/playwright-go/cmd/playwright@v0.5700.1 install chromium \
  && CGO_ENABLED=0 GOOS=linux go build -o crawler-go .

FROM mcr.microsoft.com/playwright:v1.60.0-noble AS build
WORKDIR /app
COPY package*.json ./
COPY server/package*.json server/
COPY client/package*.json client/
RUN npm ci
COPY . .
RUN npm run build --workspace server

FROM mcr.microsoft.com/playwright:v1.60.0-noble
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
COPY server/package*.json server/
COPY client/package*.json client/
RUN npm ci --omit=dev --workspace server
COPY --from=build /app/server/dist server/dist
COPY --from=go-build /app/services/crawler-go/crawler-go services/crawler-go/crawler-go
COPY --from=go-build /root/.cache/ms-playwright /root/.cache/ms-playwright
CMD ["npm", "run", "start", "--workspace", "server"]
