{
  "name": "web-intelligence-crawler",
  "version": "1.0.0",
  "private": true,
  "description": "Recursive web intelligence crawler with a React analytics dashboard.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:worker": "npm run dev:worker --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace client",
    "test": "npm run test --workspace server",
    "test:lb": "powershell -ExecutionPolicy Bypass -File scripts/test-load-balancer.ps1",
    "test:workers": "node scripts/test-rust-workers.mjs",
    "test:ws": "node scripts/test-websockets.mjs",
    "bench:servers": "node scripts/bench-servers.mjs",
    "start:lb:local": "powershell -ExecutionPolicy Bypass -File scripts/start-local-load-balancer.ps1",
    "stop:lb:local": "powershell -ExecutionPolicy Bypass -File scripts/stop-local-load-balancer.ps1",
    "benchmark:crawl": "node scripts/crawl-benchmark.js"
  }
}
